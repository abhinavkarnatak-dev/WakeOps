generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MembershipRole {
  ADMIN
  MEMBER
}

model User {
  id            String       @id @default(cuid())
  name          String?
  email         String?      @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  memberships   Membership[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Organization {
  id           String              @id @default(cuid())
  name         String
  slug         String              @unique
  memberships  Membership[]
  engineers    Engineer[]
  applications Application[]
  environments Environment[]
  resources    MonitoredResource[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
}

enum MonitoringSource {
  ALERTMANAGER
  GRAFANA
  CLOUDWATCH
}

model Engineer {
  id                   String             @id @default(cuid())
  organizationId       String
  name                 String
  email                String
  phoneNumber          String
  phoneCountry         String?
  organization         Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  primaryAssignments   OnCallAssignment[] @relation("PrimaryEngineer")
  secondaryAssignments OnCallAssignment[] @relation("SecondaryEngineer")
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@unique([organizationId, id])
  @@unique([organizationId, email])
}

model Application {
  id             String            @id @default(cuid())
  organizationId String
  name           String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  mappings       ResourceMapping[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([organizationId, id])
  @@unique([organizationId, name])
}

model Environment {
  id             String            @id @default(cuid())
  organizationId String
  name           String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  mappings       ResourceMapping[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([organizationId, id])
  @@unique([organizationId, name])
}

model MonitoredResource {
  id                 String            @id @default(cuid())
  organizationId     String
  source             MonitoringSource
  externalIdentifier String
  name               String
  organization       Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  mappings           ResourceMapping[]
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@unique([organizationId, id])
  @@unique([organizationId, source, externalIdentifier])
}

model ResourceMapping {
  id             String            @id @default(cuid())
  organizationId String
  resourceId     String
  applicationId  String
  environmentId  String
  resource       MonitoredResource @relation(fields: [organizationId, resourceId], references: [organizationId, id], onDelete: Cascade)
  application    Application       @relation(fields: [organizationId, applicationId], references: [organizationId, id], onDelete: Restrict)
  environment    Environment       @relation(fields: [organizationId, environmentId], references: [organizationId, id], onDelete: Restrict)
  assignment     OnCallAssignment?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([organizationId, id])
  @@unique([organizationId, resourceId, applicationId, environmentId])
}

model OnCallAssignment {
  id                  String          @id @default(cuid())
  organizationId      String
  mappingId           String          @unique
  primaryEngineerId   String
  secondaryEngineerId String?
  mapping             ResourceMapping @relation(fields: [organizationId, mappingId], references: [organizationId, id], onDelete: Cascade)
  primaryEngineer     Engineer        @relation("PrimaryEngineer", fields: [organizationId, primaryEngineerId], references: [organizationId, id], onDelete: Restrict)
  secondaryEngineer   Engineer?       @relation("SecondaryEngineer", fields: [organizationId, secondaryEngineerId], references: [organizationId, id], onDelete: Restrict)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@unique([organizationId, mappingId])
}

model Membership {
  id             String         @id @default(cuid())
  userId         String
  organizationId String
  role           MembershipRole @default(MEMBER)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([userId, organizationId])
  @@index([organizationId])
}
