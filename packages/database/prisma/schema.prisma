generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MembershipRole {
  ADMIN
  MEMBER
}

model User {
  id            String                 @id @default(cuid())
  name          String?
  email         String?                @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  memberships   Membership[]
  oauthStates   OAuthConnectionState[]
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Organization {
  id                 String                  @id @default(cuid())
  name               String
  slug               String                  @unique
  memberships        Membership[]
  engineers          Engineer[]
  applications       Application[]
  environments       Environment[]
  resources          MonitoredResource[]
  grafanaIntegration GrafanaIntegration?
  webhookTests       MonitoringWebhookTest[]
  incidents          Incident[]
  alertEvents        AlertEvent[]
  slackInstallation  SlackInstallation?
  slackDestinations  SlackDestination[]
  oauthStates        OAuthConnectionState[]
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
}

model GrafanaIntegration {
  id             String       @id @default(cuid())
  organizationId String       @unique
  secretHash     String
  secretHint     String
  lastVerifiedAt DateTime?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model MonitoringWebhookTest {
  id             String           @id @default(cuid())
  organizationId String
  source         MonitoringSource
  receiver       String?
  status         String
  alertCount     Int
  alertName      String?
  payloadPreview Json?
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  receivedAt     DateTime         @default(now())

  @@index([organizationId, source, receivedAt])
}

enum MonitoringSource {
  GRAFANA
}

enum AlertSeverity {
  CRITICAL
  WARNING
  INFO
}

enum AlertLifecycleStatus {
  FIRING
  RESOLVED
}

enum AlertProcessingStatus {
  PROCESSED
  DEDUPLICATED
  MAPPING_FAILED
  UNMATCHED_RESOLUTION
}

enum IncidentStatus {
  OPEN
  NOTIFYING
  ACKNOWLEDGED
  RESOLVED
}

enum AuditEventType {
  ALERT_RECEIVED
  INCIDENT_CREATED
  ALERT_DEDUPLICATED
  INCIDENT_RESOLVED
  CALL_REQUESTED
  CALL_STATUS_UPDATED
  NOTIFICATION_REQUESTED
  NOTIFICATION_STATUS_UPDATED
}

enum NotificationChannel {
  EMAIL
  SLACK
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum CallAttemptStatus {
  CREATED
  QUEUED
  RINGING
  IN_PROGRESS
  COMPLETED
  FAILED
  NO_ANSWER
  BUSY
  CANCELED
}

model Engineer {
  id                   String             @id @default(cuid())
  organizationId       String
  name                 String
  email                String
  phoneNumber          String
  phoneCountry         String?
  organization         Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  primaryAssignments   OnCallAssignment[] @relation("PrimaryEngineer")
  secondaryAssignments OnCallAssignment[] @relation("SecondaryEngineer")
  callAttempts         CallAttempt[]
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@unique([organizationId, id])
  @@unique([organizationId, email])
}

model Application {
  id             String            @id @default(cuid())
  organizationId String
  name           String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  mappings       ResourceMapping[]
  incidents      Incident[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([organizationId, id])
  @@unique([organizationId, name])
}

model Environment {
  id             String            @id @default(cuid())
  organizationId String
  name           String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  mappings       ResourceMapping[]
  incidents      Incident[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([organizationId, id])
  @@unique([organizationId, name])
}

model MonitoredResource {
  id                 String            @id @default(cuid())
  organizationId     String
  source             MonitoringSource
  externalIdentifier String
  name               String
  organization       Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  mappings           ResourceMapping[]
  incidents          Incident[]
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@unique([organizationId, id])
  @@unique([organizationId, source, externalIdentifier])
}

model ResourceMapping {
  id             String            @id @default(cuid())
  organizationId String
  resourceId     String
  applicationId  String
  environmentId  String
  resource       MonitoredResource @relation(fields: [organizationId, resourceId], references: [organizationId, id], onDelete: Cascade)
  application    Application       @relation(fields: [organizationId, applicationId], references: [organizationId, id], onDelete: Restrict)
  environment    Environment       @relation(fields: [organizationId, environmentId], references: [organizationId, id], onDelete: Restrict)
  assignment     OnCallAssignment?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([organizationId, id])
  @@unique([organizationId, resourceId, applicationId, environmentId])
}

model OnCallAssignment {
  id                  String          @id @default(cuid())
  organizationId      String
  mappingId           String          @unique
  primaryEngineerId   String
  secondaryEngineerId String?
  mapping             ResourceMapping @relation(fields: [organizationId, mappingId], references: [organizationId, id], onDelete: Cascade)
  primaryEngineer     Engineer        @relation("PrimaryEngineer", fields: [organizationId, primaryEngineerId], references: [organizationId, id], onDelete: Restrict)
  secondaryEngineer   Engineer?       @relation("SecondaryEngineer", fields: [organizationId, secondaryEngineerId], references: [organizationId, id], onDelete: Restrict)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@unique([organizationId, mappingId])
}

model Incident {
  id                   String                @id @default(cuid())
  organizationId       String
  applicationId        String
  environmentId        String
  resourceId           String
  source               MonitoringSource
  fingerprint          String
  activeFingerprint    String?
  alertName            String
  severity             AlertSeverity
  value                String?
  status               IncidentStatus        @default(OPEN)
  labels               Json
  annotations          Json
  metadata             Json
  startedAt            DateTime
  lastSeenAt           DateTime
  acknowledgedAt       DateTime?
  resolvedAt           DateTime?
  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  application          Application           @relation(fields: [organizationId, applicationId], references: [organizationId, id], onDelete: Restrict)
  environment          Environment           @relation(fields: [organizationId, environmentId], references: [organizationId, id], onDelete: Restrict)
  resource             MonitoredResource     @relation(fields: [organizationId, resourceId], references: [organizationId, id], onDelete: Restrict)
  alertEvents          AlertEvent[]
  auditEvents          AuditEvent[]
  callAttempts         CallAttempt[]
  notificationAttempts NotificationAttempt[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@unique([organizationId, activeFingerprint])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, fingerprint, createdAt])
}

model NotificationAttempt {
  id                String              @id @default(cuid())
  incidentId        String
  channel           NotificationChannel
  status            NotificationStatus  @default(PENDING)
  destination       String
  attemptCount      Int                 @default(0)
  providerMessageId String?
  failureMessage    String?
  sentAt            DateTime?
  incident          Incident            @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@unique([incidentId, channel])
  @@index([status, createdAt])
}

model SlackInstallation {
  id                   String             @id @default(cuid())
  organizationId       String             @unique
  teamId               String
  teamName             String
  botUserId            String?
  accessTokenEncrypted String             @db.Text
  scopes               String
  organization         Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  destinations         SlackDestination[]
  connectedAt          DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([teamId])
}

model SlackDestination {
  id             String            @id @default(cuid())
  organizationId String            @unique
  installationId String
  channelId      String
  channelName    String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  installation   SlackInstallation @relation(fields: [installationId], references: [id], onDelete: Cascade)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([installationId, channelId])
}

model OAuthConnectionState {
  stateHash      String       @id
  organizationId String
  userId         String
  provider       String
  expiresAt      DateTime
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@index([expiresAt])
}

model CallAttempt {
  id                  String            @id @default(cuid())
  incidentId          String
  engineerId          String
  attemptNumber       Int
  status              CallAttemptStatus @default(CREATED)
  providerCallId      String?           @unique
  submissionStartedAt DateTime?
  initiatedAt         DateTime?
  answeredAt          DateTime?
  completedAt         DateTime?
  failureCode         String?
  failureMessage      String?
  incident            Incident          @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  engineer            Engineer          @relation(fields: [engineerId], references: [id], onDelete: Restrict)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@unique([incidentId, engineerId, attemptNumber])
  @@index([incidentId, createdAt])
  @@index([engineerId, createdAt])
}

model AlertEvent {
  id                 String                @id @default(cuid())
  organizationId     String
  incidentId         String?
  source             MonitoringSource
  eventKey           String
  externalEventId    String?
  lifecycleStatus    AlertLifecycleStatus
  processingStatus   AlertProcessingStatus
  mappingError       String?
  alertName          String?
  resourceIdentifier String?
  service            String?
  environment        String?
  severity           String?
  value              String?
  labels             Json
  annotations        Json
  metadata           Json
  startedAt          DateTime
  endedAt            DateTime?
  organization       Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  incident           Incident?             @relation(fields: [incidentId], references: [id], onDelete: SetNull)
  receivedAt         DateTime              @default(now())

  @@unique([organizationId, eventKey])
  @@index([organizationId, receivedAt])
  @@index([incidentId, receivedAt])
}

model AuditEvent {
  id         String         @id @default(cuid())
  incidentId String
  type       AuditEventType
  details    Json?
  incident   Incident       @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  occurredAt DateTime       @default(now())

  @@index([incidentId, occurredAt])
}

model Membership {
  id             String         @id @default(cuid())
  userId         String
  organizationId String
  role           MembershipRole @default(MEMBER)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([userId, organizationId])
  @@index([organizationId])
}
