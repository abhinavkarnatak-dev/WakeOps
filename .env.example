# Core
NODE_ENV=development
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000
WEBHOOK_PUBLIC_BASE_URL=
PORT=4000
LOG_LEVEL=info

# PostgreSQL / Prisma
DATABASE_URL=postgresql://wakeops:wakeops@localhost:5432/wakeops?schema=public

# Google OAuth
AUTH_SECRET=replace-with-a-long-random-value
AUTH_GOOGLE_ID=replace-with-google-client-id
AUTH_GOOGLE_SECRET=replace-with-google-client-secret

# Future: credential encryption
ENCRYPTION_KEY=replace-with-32-byte-base64-key

# Temporal Cloud
TEMPORAL_ADDRESS=wakeops-dev.account-id.tmprl.cloud:7233
TEMPORAL_NAMESPACE=wakeops-dev.account-id
TEMPORAL_TASK_QUEUE=wakeops-incidents
TEMPORAL_API_KEY=replace-with-temporal-api-key

# Future: RabbitMQ notifications
AMQP_URL=amqp://guest:guest@localhost:5672

# Redis
REDIS_URL=redis://localhost:6379

# Future: Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WEBHOOK_BASE_URL=

# Future: Deepgram
DEEPGRAM_API_KEY=

# Future: ElevenLabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Future: Email
RESEND_API_KEY=
EMAIL_FROM=

# Future: Slack OAuth
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_REDIRECT_URI=

# Future: GitHub App
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ChatGPT OAuth
OPENAI_CHATGPT_CLIENT_ID=
OPENAI_CHATGPT_REDIRECT_URI=

# Future: observability
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=wakeops-api
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
